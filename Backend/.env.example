NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://agora:agora@localhost:5432/agora
DATABASE_SSL_MODE=disable
AGORA_SESSION_SECRET=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
APPLE_BUNDLE_ID=com.theagora.la
APPLE_CLIENT_ID=com.theagora.la
APPLE_TEAM_ID=
APPLE_KEY_ID=
# For hosted deployments, store the complete .p8 value as a secret in this variable.
APPLE_PRIVATE_KEY=
# Local deployments may use a mounted file instead.
APPLE_PRIVATE_KEY_PATH=/run/secrets/AuthKey_SignInWithApple.p8
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_ENVIRONMENT=Sandbox
APPLE_APP_ID=
APPLE_ROOT_CA_PATHS=certs/AppleIncRootCertificate.cer,certs/AppleRootCA-G2.cer,certs/AppleRootCA-G3.cer
WELCOME_CREDITS=0
DAILY_SCORE_LIMIT=60
ALLOW_DEV_AUTH=true
MAX_AUDIO_BYTES=262144000
TRANSCRIPTION_CONCURRENCY=3
ANALYSIS_CONCURRENCY=4
JOB_WORKER_CONCURRENCY=2
JOB_RETENTION_DAYS=7
OPENAI_EXTRACTION_MODEL=openai/gpt-5.6-terra
OPENAI_CURATION_MODEL=openai/gpt-6-astra
OPENAI_SCORING_MODEL=openai/gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=openai/whisper-large-v3
CREDIT_PRODUCT_GRANTS=com.theagora.la.credits.5:5,com.theagora.la.credits.20:22,com.theagora.la.credits.50:60
